# Gibbon Benchmark Configuration
# Copy this file and customize as needed

# === DIRECTORIES ===
PROGRAMS_DIR="programs"
OUTPUT_DIR="benchmark_output"

# === BENCHMARK PARAMETERS ===
ITERATIONS=20
# Increase for more stable results, decrease for faster runs
# Recommended: 20-50 for development, 100+ for publication

# === PROGRAMS TO BENCHMARK ===
# Leave empty to benchmark all programs
# Or specify programs like: "Compiler.hs List.hs Trie.hs"
PROGRAMS=""

# === OUTPUT FILES ===
REPORT_FILE="benchmark_report.txt"
JSON_FILE="benchmark_results.json"

# === COMPILATION OPTIONS ===
# These are the standard Gibbon flags used
# Modify in the scripts if you need different flags
GIBBON_FLAGS=(
    "--use-mutable-cursors"
    "--packed"
    "--to-exe"
)

# === TIMEOUTS (in seconds) ===
COMPILE_TIMEOUT=300   # 5 minutes
RUN_TIMEOUT=600       # 10 minutes

# === PERFORMANCE METRICS TO EXTRACT ===
# The scripts extract these by default:
# - ITER TIMES: Array of iteration times
# - ITERS: Number of iterations
# - BATCHTIME: Total time for all iterations
# - SELFTIMED: Median iteration time
# - Final program output for correctness verification

# === EXPECTED PASSES ===
# These are the compiler passes that will be analyzed
EXPECTED_PASSES=(
    "instCountPass"
    "blockCountPass"
    "memoryOpStatsPass"
    "castInstCountPass"
    "branchStatsPass"
    "latencyModelPass"
    "has cycle"
    "throughputModelPass"
    "targetRetunePass"
    "stripSideEffectsPass"
)

# === ANALYSIS OPTIONS ===
# What comparisons to perform
COMPARE_OUTPUTS=true          # Verify AoS and SoA produce same output
COMPARE_PERFORMANCE=true      # Compare execution times
GENERATE_JSON=true            # Generate machine-readable JSON
GENERATE_TEXT_REPORT=true    # Generate human-readable report

# === SYSTEM REQUIREMENTS ===
# Recommended system specifications for accurate benchmarking:
# - Dedicated benchmark machine (no other processes)
# - Minimum 8GB RAM
# - At least 10GB free disk space
# - Linux or macOS (for consistent timing)

# === EXAMPLE USAGE ===
# Using this configuration with Python script:
#   ./gibbon_benchmark.py \
#     --programs-dir "$PROGRAMS_DIR" \
#     --output-dir "$OUTPUT_DIR" \
#     --iterations "$ITERATIONS" \
#     --report "$REPORT_FILE" \
#     --json "$JSON_FILE"
#
# Using with Bash script:
#   ./gibbon_benchmark.sh "$PROGRAMS_DIR" "$ITERATIONS"

# === ADVANCED: PARALLEL COMPILATION ===
# To speed up benchmarking, you could modify the scripts to compile
# multiple programs in parallel. However, this may affect accuracy
# of timing measurements.

# === STATISTICAL NOTES ===
# - First iteration is often slower (warm-up effect)
# - Median time (SELFTIMED) is more robust than mean
# - Look for consistency in ITER TIMES array
# - High variance suggests system interference or GC effects

# === TROUBLESHOOTING ===
# If benchmarks fail:
# 1. Check Gibbon is installed: which gibbon
# 2. Verify directory structure matches expected layout
# 3. Ensure sufficient disk space
# 4. Check system resources (RAM, CPU)
# 5. Review error messages in output directory
# 6. Try running a single program manually

# === RESULT INTERPRETATION ===
# Good benchmark results show:
# - ✓ All compilations successful
# - ✓ All runs successful
# - ✓ Outputs match between AoS and SoA
# - Low variance in iteration times
# - Consistent performance across multiple runs

# === PUBLISHING RESULTS ===
# When reporting benchmark results:
# 1. Include system specifications
# 2. Report median times with variance
# 3. State number of iterations used
# 4. Verify outputs match (correctness)
# 5. Run multiple times and report averages
# 6. Note any anomalies or outliers
